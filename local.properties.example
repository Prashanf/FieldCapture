# FieldCapture API Configuration
# Copy this file to local.properties and add your keys.
# DO NOT commit local.properties to git.

# Get your free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY_1=your_gemini_api_key_here

# Optional: additional keys from separate projects/accounts for 429 rate-limit rotation (20 RPD/key)
# GEMINI_API_KEY_2=second_key_here
# GEMINI_API_KEY_3=third_key_here

sdk.dir=/path/to/your/Android/Sdk
